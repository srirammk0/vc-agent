{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@composio/core": ["./node_modules/@composio/core/dist/index.d.mts"]
    }
  },
  "include": ["src/**/*", "lib/**/*", "trigger.config.ts"],
  "exclude": ["node_modules", "dist"]
}
