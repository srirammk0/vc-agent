# =============================================================================
# VC Research Agent — environment variables
#
# Three places need env vars:
#   [MODAL]      the Python agent runs here (LLM, search, memory, iMessage) —
#                all the agentic work. Set these as a Modal secret named
#                `vc-scout-secrets`.
#   [TRIGGER]    Trigger.dev — scheduling only (fixed crons + one-off delayed
#                triggers), no agentic work. Set these in the Trigger.dev
#                dashboard's environment variables, per environment.
#   [VERCEL]     the Next.js dashboard + auth.
# Locally (.env) set all of them so the agent, `npm run dev`, and
# `npm run trigger:dev` work end-to-end.
# =============================================================================

# --- LLM -------------------------------------------------------- [MODAL + VERCEL]
# Anthropic Claude Sonnet 4.6 — SMS, scout, and news digest (prompt caching enabled)
# Anthropic Claude Haiku 4.5 — enrichment, dashboard feedback, and other light tasks
# Also needed on Vercel: api/chat.py (web chat) runs the agent directly, not via Modal.
ANTHROPIC_API_KEY=

# --- Signals filter model ---------------------------------------------- [MODAL]
# Cerebras-hosted Gemma 4 (gemma-4-31b) — strict structured-output pass for the
# signals scraper (agent/signals_scraper.py: gemma_filter). Replaced a self-hosted
# Modal SGLang server (GPU keep-warm cost wasn't worth it for this).
CEREBRAS_API_KEY=

# --- Search ------------------------------------------------------ [MODAL + VERCEL]
# Exa.ai — startup discovery, deep research, enrichment
# Also needed on Vercel: web chat's registered tools call these directly.
EXA_API_KEY=
# Linkup — VC news, fund blogs, press coverage checks, quick facts
LINKUP_API_KEY=

# --- Memory (Supermemory) --------------------------------------- [MODAL + VERCEL]
# The agent's brain: thesis, preferences, startups, reflections.
# Also used directly by the dashboard's status PATCH route to mirror quick
# approve/pass/mark-new clicks into Supermemory (see src/lib/supermemory.ts).
SUPERMEMORY_API_KEY=

# --- Mirror (Supabase) ------------------------------------------------ [MODAL + VERCEL]
# Read-only mirror of Supermemory for the dashboard (populated by the sync job).
# Service role is server-side only (bypasses RLS) for all reads/writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public anon key — browser-side, used ONLY for realtime subscriptions.
# Without these the dashboard falls back to polling (still live, just less instant).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Dashboard auth ---------------------------------------------------- [VERCEL]
# Password for the dashboard login page. Was hardcoded in src/app/login/actions.ts
# (and therefore in git history) — rotate to something new, this is the only gate on
# the whole dashboard.
DASHBOARD_PASSWORD=
# Signing key for the session cookie. Any long random string
# (`openssl rand -hex 32`). The cookie used to be the literal value "ok", which
# anyone could set by hand; it's now an HMAC token only this secret can produce.
# Read by BOTH the Next app (src/lib/auth.ts, src/proxy.ts) and the Python web-chat
# function (api/chat.py) — same value, both are Vercel env vars.
DASHBOARD_SESSION_SECRET=

# --- Dashboard -> Modal shared secret ---------------------------- [MODAL + VERCEL]
# Modal's dashboard-facing endpoints (enrich_startup, submit_feedback,
# cancel/reschedule_scheduled_task) are public URLs — this is what proves a caller is
# the dashboard's server-side route and not a stranger who found the URL. Generate a
# random string; must match on both sides. If unset, modal_app.py falls back to
# accepting SCHEDULER_SHARED_SECRET, so a single-secret deployment still works.
DASHBOARD_SHARED_SECRET=

# --- Enrichment endpoint ---------------------------------------------- [VERCEL]
# Modal enrich_startup web endpoint, triggered by the dashboard "Enrich" button.
MODAL_ENRICH_URL=https://[your-modal-app]-enrich-startup.modal.run
# Modal submit_feedback endpoint — dashboard approve/pass reasons → agent memory.
MODAL_FEEDBACK_URL=https://[your-modal-app]-submit-feedback.modal.run

# --- Scheduled task management ---------------------------------------- [VERCEL]
# Modal endpoints the Scheduled Runs page's Cancel/Reschedule buttons call.
MODAL_CANCEL_SCHEDULED_TASK_URL=https://[your-modal-app]-cancel-scheduled-task.modal.run
MODAL_RESCHEDULE_SCHEDULED_TASK_URL=https://[your-modal-app]-reschedule-scheduled-task.modal.run

# Website chat tab (api/chat.py) runs on Vercel directly — no Modal URL needed.
# It requires ANTHROPIC_API_KEY, EXA_API_KEY, LINKUP_API_KEY, SUPERMEMORY_API_KEY,
# SUPABASE_URL, and SUPABASE_SERVICE_ROLE_KEY to be set as Vercel env vars (see above).

# --- iMessage (SendBlue) ---------------------------------------------- [MODAL]
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# Primary owner — used for scheduled alerts if NOTIFY_PHONE_NUMBERS is unset.
ALERT_PHONE_NUMBER=+1
# Comma-separated numbers allowed to text the agent (E.164). If unset, only ALERT_PHONE_NUMBER can chat.
# ALLOWED_PHONE_NUMBERS=+15551234567,+15559876543
# Comma-separated numbers for scheduled scout/brief SMS. If unset, only ALERT_PHONE_NUMBER is notified.
# NOTIFY_PHONE_NUMBERS=+1,+1
# The SendBlue number messages are sent FROM (required on the free API plan).
SENDBLUE_FROM_NUMBER=+1
# Optional but recommended: a random string appended to the webhook URL you register
# with SendBlue (https://...-sendblue-webhook.modal.run?secret=THIS). The sender
# number is only a body field, so without this anyone who learns the URL can forge an
# inbound message from an allowed number and drive the agent.
SENDBLUE_WEBHOOK_SECRET=

# --- Tracing ---------------------------------------------------------- [MODAL]
# Logfire — optional; tracing is skipped if unset.
LOGFIRE_TOKEN=

# --- Scheduling (Trigger.dev) ------------------------------------ [MODAL + TRIGGER]
# Modal calls OUT to Trigger.dev's REST API (agent/trigger_client.py) to schedule
# one-off delayed checks (signal re-checks, follow-up texts, daily portfolio
# checks) — this is the Trigger.dev secret key, needed on the Modal side.
TRIGGER_SECRET_KEY=
# Shared secret Trigger.dev sends (in the request body) on every call it makes
# INTO Modal — checked by modal_app.py's _check_scheduler_secret. Generate any
# random string; must match on both sides.
SCHEDULER_SHARED_SECRET=

# --- Trigger.dev's own env vars (set in the Trigger.dev dashboard, not here) --- [TRIGGER]
# The deployed Modal endpoint URLs Trigger.dev's tasks forward to (printed by
# `modal deploy`), plus SCHEDULER_SHARED_SECRET (same value as above):
#   MODAL_SYNC_URL, MODAL_RUN_SCHEDULED_CHECK_URL,
#   SCHEDULER_SHARED_SECRET
