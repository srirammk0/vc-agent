# Required for Exa.ai company, fast, and people search
EXA_API_KEY=

# Required for Gemini 3.1 Flash Lite scoring
GEMINI_API_KEY=

# Required for Composio Gmail integration
COMPOSIO_API_KEY=

# Your Composio user ID — set during Composio onboarding (typically your email)
# Find it at: https://app.composio.dev → Settings → User ID
COMPOSIO_USER_ID=

# Gmail recipient address for the debrief email (can be your own Gmail)
GMAIL_TO=you@gmail.com

PASS_SCORE_THRESHOLD=6.5       # minimum overall_score to pass (default 6.5)
PASS_THESIS_THRESHOLD=6        # minimum thesis_fit score to pass (default 6)
