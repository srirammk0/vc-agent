# =============================================================================
# VC Research Agent — environment variables
#
# Two places need env vars now (Modal is gone):
#   [TRIGGER]    Trigger.dev — the agent's Python actually runs here (via the
#                pythonExtension build extension, see trigger.config.ts), plus
#                scheduling (fixed timing for delayed follow-ups, not agentic
#                work itself). Set these in the Trigger.dev dashboard's
#                environment variables, per environment.
#   [VERCEL]     the Next.js dashboard + auth + web chat (api/chat.py, which
#                imports agent/agent.py directly — no Trigger.dev hop for that
#                surface specifically).
# Locally (.env) set all of them so `npm run dev` and `npm run trigger:dev`
# work end-to-end.
# =============================================================================

# --- LLM ----------------------------------------------------- [TRIGGER + VERCEL]
# Anthropic Claude Sonnet — dashboard chat, scheduled runs (prompt caching enabled)
# Anthropic Claude Haiku — feedback distillation and other light tasks
ANTHROPIC_API_KEY=

# --- Search ---------------------------------------------------- [TRIGGER + VERCEL]
# Exa.ai — startup discovery, deep research, enrichment
EXA_API_KEY=
# Linkup — VC news, fund blogs, press coverage checks, quick facts
LINKUP_API_KEY=

# --- Enrichment (Clay) ----------------------------------------- [TRIGGER]
# Clay Public API — founder work email lookup during Enrich (agent/tools/clay.py).
# Create a key: Clay app → Settings → Account → API keys (beta), or `clay api-keys create`.
CLAY_API_KEY=
# Routine id for Clay's Work Email managed function (format: function:tbl_...).
# Find it after enabling API on the function: `clay routines list` and pick the Work Email routine.
CLAY_WORK_EMAIL_ROUTINE_ID=

# --- Memory (Supermemory) --------------------------------------- [TRIGGER + VERCEL]
# The agent's brain: thesis and learned seek/avoid preferences only. Dealflow
# (startups) is NOT stored here — it lives directly in Supabase
# (agent/startups_store.py). Only the agent's feedback mode (approve/pass
# reasons) writes here, via write_preferences.
SUPERMEMORY_API_KEY=

# --- Database (Supabase) ----------------------------------------- [TRIGGER + VERCEL]
# Dealflow (startups), scheduled-task log, and the general-purpose cache all live
# here directly — there is no mirroring step for any of it. Service role is
# server-side only (bypasses RLS) for all reads/writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public anon key — browser-side, used ONLY for realtime subscriptions.
# Without these the dashboard falls back to polling (still live, just less instant).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Dashboard auth ---------------------------------------------------- [VERCEL]
# Password for the dashboard login page. Was hardcoded in an earlier version of
# src/app/login/actions.ts (and therefore in that commit's git history) —
# rotate to something new if you're on that old code, this is the only gate on
# the whole dashboard.
DASHBOARD_PASSWORD=
# Signing key for the session cookie. Any long random string
# (`openssl rand -hex 32`). Read by BOTH the Next app (src/lib/auth.ts,
# src/proxy.ts) and the Python web-chat function (api/chat.py) — same value,
# both are Vercel env vars.
DASHBOARD_SESSION_SECRET=

# --- Scheduling / job dispatch (Trigger.dev) ------------------ [TRIGGER + VERCEL]
# The agent's own future work — schedule_agent_run follow-ups — is scheduled by
# calling Trigger.dev's REST API directly from Python (agent/trigger_client.py),
# no JS SDK involved (it runs inside the Python subprocess Trigger.dev itself
# shells out to). This is that REST API's secret key — needed both on Trigger.dev
# (where trigger_client.py actually executes) and on Vercel (src/lib/
# scheduledTasks.ts calls the same REST endpoints directly for the dashboard's
# Cancel/Reschedule buttons — see README.md's Scheduling section for why that's
# a separate TypeScript implementation rather than routed through a task).
TRIGGER_SECRET_KEY=

# --- Tracing -------------------------------------------------- [TRIGGER + VERCEL]
# Logfire — optional; tracing is skipped if unset.
LOGFIRE_TOKEN=
