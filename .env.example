# =============================================================================
# VC Research Agent (v4) — environment variables
#
# Two runtimes need env vars:
#   [TRIGGER.DEV]  the Python agent runs here (LLM, search, memory, iMessage)
#   [VERCEL]       the Next.js app: dashboard, "run now", SendBlue inbound webhook
# Locally (.env) set all of them so `npm run dev` works end-to-end.
# =============================================================================

# --- LLM -------------------------------------------------------------- [TRIGGER.DEV]
# NVIDIA NIM — serves the agent model (minimaxai/minimax-m3)
NVIDIA_API_KEY=

# --- Search ----------------------------------------------------------- [TRIGGER.DEV]
# Exa.ai — all web + LinkedIn search (discovery, contents)
EXA_API_KEY=

# --- iMessage (SendBlue) ---------------------------------------------- [TRIGGER.DEV + VERCEL]
# Outbound replies/alerts run on Trigger.dev; the inbound webhook runs on Vercel.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# Your phone number — both the alert target and the only number allowed to chat.
ALERT_PHONE_NUMBER=+1
# The SendBlue number messages are sent FROM (required on the free API plan).
# Find it in the SendBlue dashboard under your number/line.
SENDBLUE_FROM_NUMBER=+1

# --- Memory (Vercel Blob) --------------------------------------------- [TRIGGER.DEV + VERCEL]
# The entire brain is a single brain.json in Vercel Blob. Create a store with
#   `vercel blob create-store` (or the Vercel dashboard) and paste its token.
BLOB_READ_WRITE_TOKEN=

# --- Tracing ---------------------------------------------------------- [TRIGGER.DEV]
# Logfire — optional; tracing is skipped if unset
LOGFIRE_TOKEN=

# --- Trigger.dev ------------------------------------------------------ [VERCEL + local]
# Lets the Next.js app trigger tasks. tr_dev_ locally, tr_prod_ on Vercel.
TRIGGER_SECRET_KEY=
