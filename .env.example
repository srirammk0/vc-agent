# Exa
EXA_API_KEY=your_exa_api_key

# Linkup
LINKUP_API_KEY=your_linkup_api_key

# Parallel
PARALLEL_API_KEY=your_parallel_api_key
PARALLEL_X_MONITOR_ID=from_setup_script
PARALLEL_LINKEDIN_MONITOR_ID=from_setup_script

# Gemini
GEMINI_API_KEY=your_gemini_api_key
# Optional: Defaults to Google AI Studio if empty
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Composio + Gmail
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_USER_ID=your_composio_user_id
GMAIL_TO=you@example.com

# Trigger.dev
TRIGGER_WEBHOOK_URL=your_trigger_webhook_url

# Scoring thresholds (tunable without redeployment)
PASS_SCORE_THRESHOLD=6.5
PASS_THESIS_THRESHOLD=6
