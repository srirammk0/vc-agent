# NVIDIA NIM — DeepSeek V4 Pro
NVIDIA_API_KEY=

# Exa.ai — web + social search
EXA_API_KEY=

# Firecrawl — page enrichment + monitor webhooks
FIRECRAWL_API_KEY=
# Shared secret: set the same value as the "x-firecrawl-secret" header on your
# monitor's webhook in the Firecrawl dashboard. Webhook requests without it are rejected.
FIRECRAWL_WEBHOOK_SECRET=
# Optional JSON map of monitorId -> human-readable name, e.g. {"mon_abc":"yc-companies"}
FIRECRAWL_MONITOR_IDS=

# SendBlue — iMessage alerts
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
ALERT_PHONE_NUMBER=+1...

# Logfire — tracing
LOGFIRE_TOKEN=

# Trigger.dev (auto-set when you run `npm run dev`)
TRIGGER_SECRET_KEY=

# Optional legacy integrations (v2 pipeline)
GEMINI_API_KEY=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
GMAIL_TO=
